PORT=4000
DB_FILE=./data/app.db
CORS_ORIGIN=http://localhost:5173

# Corporate authentication server. When unset, a dev mock is used that
# accepts any non-empty password. The mock is ONLY for local development.
CORPORATE_AUTH_URL=
# Optional extra headers, e.g. "X-App-Id: appointments"
CORPORATE_AUTH_HEADERS=

# Session TTL (hours). Default 12.
SESSION_TTL_HOURS=12
